# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Pooled Gemini keys (comma-separated). The AI helper rotates round-robin and
# fails over to the next key on quota/429 errors.
GEMINI_API_KEYS=key1,key2,key3

# Single-key fallback (used only if GEMINI_API_KEYS is unset).
GEMINI_API_KEY=your_key_here
